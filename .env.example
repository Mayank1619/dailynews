VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional local emulator setting. Omit in production.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Required by Vercel serverless functions for Firebase Admin token verification.
# Prefer one JSON value copied from a Firebase service account key:
FIREBASE_SERVICE_ACCOUNT_KEY=

# Or use the split form if your host handles multiline secrets more easily:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional local emulator setting for Firebase Admin/Auth verification.
# Omit in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
