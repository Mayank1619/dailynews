VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional local emulator setting. Omit in production.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Required by Vercel serverless functions for Firebase token lookup and project binding.
FIREBASE_PROJECT_ID=

# Required to protect newsletter preview/send API routes.
NEWSLETTER_ADMIN_TOKEN=

# Optional AI generation. If omitted, newsletter generation uses deterministic fallback content.
OPENAI_API_KEY=
OPENAI_NEWSLETTER_MODEL=gpt-4.1-mini

# Optional email sending through Brevo transactional email API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Daily Paper

# Optional local emulator setting for Firebase Admin/Auth verification.
# Omit in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
