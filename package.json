{
  "name": "dailynews",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "firebase:emulators": "npx firebase-tools@14.18.0 emulators:start --project demo-daily-paper --only auth,firestore",
    "firebase:emulators:auth": "npx firebase-tools@14.18.0 emulators:start --project demo-daily-paper --only auth",
    "marketing:publish-blog": "node marketing-ops/scripts/publish-daily-paper-blog.mjs",
    "marketing:render-videos": "node marketing-ops/scripts/render-video.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration apps/web/tests/a11y --passWithNoTests",
    "test:e2e": "playwright test tests/e2e"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
